# Copie para .env (cp .env.example .env) e ajuste. O .env nunca é versionado.
# Usado pelo Docker Compose e pela API rodando fora do Docker (npm run start:dev em apps/api).

# ---------- PostgreSQL (Docker Compose) ----------
POSTGRES_USER=gameshelf
POSTGRES_PASSWORD=gameshelf
POSTGRES_DB=gameshelf
POSTGRES_PORT=5432
API_PORT=3000

# ---------- API ----------
NODE_ENV=development
PORT=3000
# Fora do Docker a API acessa o PostgreSQL publicado em localhost.
# Dentro do Compose esta variável é substituída pelo host "postgres".
DATABASE_URL=postgresql://gameshelf:gameshelf@localhost:5432/gameshelf

# Obrigatório. A API não sobe sem ele (mínimo de 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=

# Access token: 15 minutos. Refresh: 7 dias de inatividade, sessão de no máximo 30 dias.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Cookies Secure funcionam em http://localhost no Chrome e no Firefox.
COOKIE_SECURE=true
# Origens do frontend (CORS + proteção CSRF), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Proxies confiáveis à frente da API (0 = acesso direto).
TRUST_PROXY_HOPS=0
